# Server / Render
NODE_ENV=production
PORT=8787
# Required only to create the first admin automatically on an empty database.
# Remove ADMIN_PASSWORD after bootstrap; it is never sent to clients or stored in plaintext.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-unique-password
ADMIN_NAME=Platform Administrator
# Alternative first-admin flow (entered only in the protected setup screen):
LEARNLY_ADMIN_SETUP_KEY=replace-with-a-long-random-secret
# SQLite and uploads must be a persistent Render Disk mount in production.
LEARNLY_DATABASE_PATH=/var/data/learnly.sqlite
LEARNLY_UPLOAD_DIR=/var/data/uploads
# Optional local-only demo data. Never set on Render.
LEARNLY_ENABLE_DEMO=false
